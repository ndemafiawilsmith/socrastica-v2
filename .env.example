# Socrastica backend configuration — placeholders only.
# Auth, saved progress, and the live mentor are integrated. Other services remain optional/pending.
# Fill secret values locally. Do not paste them into chat or prefix them NEXT_PUBLIC_.

# Required: application URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required: OpenAI project API key, used only on the server
OPENAI_API_KEY=
# Budget-approved model; changing it also requires reviewing the server budget controls.
OPENAI_MODEL=gpt-6-luna

# Required: Supabase project (authentication and persistent learning data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for authenticated server writes and the shared budget counter. Never expose in browser code.
SUPABASE_SECRET_KEY=

# Code checks run inside the web server in an isolated QuickJS sandbox. No AWS variables are needed.
# Hosting scripts use the local `socrastica` AWS CLI profile directly.

# Optional production infrastructure — leave blank until selected and integrated
# Shared rate-limit store (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional application email (Resend). Auth SMTP is configured in Supabase.
RESEND_API_KEY=
EMAIL_FROM=

# Error reporting
SENTRY_DSN=

# Optional paid plans — configure only if subscriptions are wanted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Migration-only management token. Not used by the application runtime.
SUPABASE_ACCESS_TOKEN=

# Custom SMTP for auth delivery; configure in Supabase before broader testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=Socrastica
