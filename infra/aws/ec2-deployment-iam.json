{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageWebInstanceProfile",
      "Effect": "Allow",
      "Action": ["iam:CreateInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:DeleteInstanceProfile"],
      "Resource": "arn:aws:iam::954633149655:instance-profile/socrastica-web"
    },
    {
      "Sid": "PassWebRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::954633149655:role/socrastica-web",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    }
  ]
}
