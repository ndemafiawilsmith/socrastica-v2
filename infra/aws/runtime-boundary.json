{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryAuthentication",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullProjectImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"],
      "Resource": "arn:aws:ecr:us-east-1:954633149655:repository/socrastica-*"
    },
    {
      "Sid": "ProjectLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:954633149655:log-group:/socrastica/*:*"
    },
    {
      "Sid": "ProjectFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::socrastica-954633149655-*", "arn:aws:s3:::socrastica-954633149655-*/*"]
    },
    {
      "Sid": "LaunchReviewedTasks",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:954633149655:task-definition/socrastica-*:*",
      "Condition": {"ArnLike": {"ecs:cluster": "arn:aws:ecs:us-east-1:954633149655:cluster/socrastica-*"}}
    },
    {
      "Sid": "InspectAndStopProjectTasks",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "arn:aws:ecs:us-east-1:954633149655:task/socrastica-*/*"
    },
    {
      "Sid": "PassExecutionRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::954633149655:role/socrastica-task-execution", "arn:aws:iam::954633149655:role/socrastica-runner"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "ReadProjectSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:954633149655:secret:socrastica/*"
    },
    {
      "Sid": "ReadProjectParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:954633149655:parameter/socrastica/*"
    }
  ]
}
