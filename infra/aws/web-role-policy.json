{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::socrastica-954633149655-execution/inputs/*",
        "arn:aws:s3:::socrastica-954633149655-execution/results/*",
        "arn:aws:s3:::socrastica-954633149655-execution/watchdogs/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:954633149655:task-definition/socrastica-runner:*",
      "Condition": { "ArnEquals": { "ecs:cluster": "arn:aws:ecs:us-east-1:954633149655:cluster/socrastica-learning" } }
    },
    {
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "arn:aws:ecs:us-east-1:954633149655:task/socrastica-learning/*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::954633149655:role/socrastica-task-execution",
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    }
  ]
}
